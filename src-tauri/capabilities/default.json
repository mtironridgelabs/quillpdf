{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Quill's window. The shell can save a PDF, check for an update, and relaunch.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart"
  ]
}
