{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Quill's window. Saving a PDF is done by the shell, which also checks for an update and relaunches.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:default",
    "updater:default",
    "process:allow-restart"
  ]
}
